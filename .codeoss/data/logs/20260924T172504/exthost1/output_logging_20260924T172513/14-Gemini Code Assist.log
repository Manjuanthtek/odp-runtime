me: Checkout code\n        uses: actions/checkout@v4\n\n      - name: Setup OPA CLI\n        uses: open-policy-agent/setup-opa@v2\n        with:\n          version: latest\n\n      - name: Build Policy Bundle\n        run: |\n          # Compiles Rego policies into a production-optimized bundle\n          opa build . -o bundle.tar.gz\n\n      - name: Log in to GitHub Container Registry\n        uses: docker/login-action@v3\n        with:\n          registry: ghcr.io\n          username: ${{ github.actor }}\n          password: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Build and Push Docker Image\n        run: |\n          # Construct the image name using your GitHub handle\n          IMAGE_ID=ghcr.io/${{ github.repository_owner }}/opa-policy-pod\n          \n          # Convert to lowercase (required for Docker tags)\n          IMAGE_ID=$(echo $IMAGE_ID | tr '[A-Z]' '[a-z]')\n          \n          echo \"Building image $IMAGE_ID...\"\n          docker build -t $IMAGE_ID:${{ github.sha }} .\n          docker tag $IMAGE_ID:${{ github.sha }} $IMAGE_ID:latest\n          docker push $IMAGE_ID:${{ github.sha }}\n          docker push $IMAGE_ID:latest","telemetry":{"CommentLines":null},"codeBlockIndex":1,"language":"yaml","checkpointFile":"f6842671f1048bc4911d04e5395b2e7869d7a636ad5032559edf5f823ca0efa0","accepted":true}]},"fileUsage":{"includedFiles":["/home/mdbaddi/.github/workflows/opa-ci.yml","/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/_distutils/compilers/C/tests/test_unix.py","/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/_distutils/tests/test_build_ext.py","/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/tests/test_editable_install.py","/home/mdbaddi/.local/lib/python3.12/site-packages/pip/_internal/cache.py","/home/mdbaddi/.local/lib/python3.12/site-packages/pip/_internal/utils/egg_link.py","/home/mdbaddi/.gemini/extensions/vertex/README.md","/home/mdbaddi/.local/lib/python3.12/site-packages/pip/_internal/vcs/git.py"