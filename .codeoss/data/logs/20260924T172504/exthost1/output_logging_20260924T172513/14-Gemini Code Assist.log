,{"path":"/home/mdbaddi/.local/lib/python3.12/site-packages/pip/_internal/vcs/git.py","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE","isUntitled":false},{"path":"/home/mdbaddi/.codeoss/data/User/globalStorage/googlecloudtools.datacloud/skill_bases/dbt-bigquery/SKILL.md","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE","isUntitled":false},{"path":"/home/mdbaddi/.gemini/skills/dbt-bigquery/SKILL.md","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE","isUntitled":false},{"path":"/home/mdbaddi/.gemini/skills/gcp-composer-troubleshooting/SKILL.md","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE","isUntitled":false}],"rules":null,"editableRegion":null,"recentUserActions":null,"chatSectionId":"5"},"openFileUri":"file:///home/mdbaddi/.github/workflows/opa-ci.yml","ragStatus":"RAG_NOT_FOUND","timeToFirstToken":"17145","agentProcessingDetails":{},"workspaceChange":{"files":[{"filePath":"/home/mdbaddi/.github/workflows/opa-ci.yml","newText":"name: OPA CI/CD\n\non:\n  push:\n    branches: [ main, master ]\n  pull_request:\n    branches: [ main, master ]\n\njobs:\n  opa-validation:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n\n      - name: Setup OPA CLI\n        uses: open-policy-agent/setup-opa@v2\n        with:\n          version: latest\n\n      - name: Check Rego Formatting\n        run: |\n          # Fails if any .rego files are not formatted according to 'opa fmt'\n          opa fmt --fail .\n\n      - name: OPA Check (Syntax Validation)\n        run: |\n          opa check .\n\n      - name: Run OPA Tests\n        run: |\n          opa test . -v\n\n  opa-deploy:\n    name: Build and Deploy OPA Bundle\n    needs: opa-validation\n    if: github.event_name == 'push' \u0026\u0026 (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master')\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n\n      - name: Setup OPA CLI\n        uses: open-policy-agent/setup-opa@v2\n        with:\n          version: latest\n\n      - name: Build Policy Bundle\n        run: |\n          # Compiles Rego policies into a production-optimized bundle\n          opa build . -o bundle.tar.gz\n\n      - name: Log in to GitHub Container Registry\n        uses: docker/login-action@v3\n        with:\n          registry: ghcr.io\n          username: ${{ github.actor }}\n          password: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Build and Push Docker Image\n        run: |\n          # Construct the image name using your GitHub handle\n          IMAGE_ID=ghcr.io/${{ github.repository_owner }}/opa-policy-pod\n          \n          # Convert to lowercase (required for Docker tags)\n          IMAGE_ID=$(echo $IMAGE_ID | tr '[A-Z]' '[a-z]')\n          \n          echo \"Building image $IMAGE_ID...\"\n          docker build -t $IMAGE_ID:${{ github.sha }} .\n          docker tag $IMAGE_ID:${{ github.sha }} $IMAGE_ID:latest\n          docker push $IMAGE_ID:${{ github.sha }}\n          docker push $IMAGE_ID:latest","telemetry":{"CommentLines":null},"codeBlockIndex":1,"language":"yaml","checkpointFile":"f6842671f1048bc4911d04e5395b2e7869d7a636ad5032559edf5f823ca0efa0","accepted":true}]},"fileUsage":{"includedFiles":["/home/mdbaddi/.github/workflows/opa-ci.yml","/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/_distutils/compilers/C/tests/test_unix.py","/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/_distutils/tests/test_build_ext.py","/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/tests/test_editable_install.py","/home/mdbaddi/.local/lib/python3.12/site-packages/pip/_internal/cache.py","/home/mdbaddi/.local/lib/python3.12/site-packages/pip/_internal/utils/egg_link.py","/home/mdbaddi/.gemini/extensions/vertex/README.md","/home/mdbaddi/.local/lib/python3.12/site-packages/pip/_internal/vcs/git.py"