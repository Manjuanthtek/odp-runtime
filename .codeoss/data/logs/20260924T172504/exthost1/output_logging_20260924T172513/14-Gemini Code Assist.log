lled on your own machine.\n\n\u003c!--\n[PROMPT_SUGGESTION]How can I configure this workflow to run on a self-hosted runner instead?[/PROMPT_SUGGESTION]\n[PROMPT_SUGGESTION]How do I add secret credentials to this GitHub Action for private OPA bundles?[/PROMPT_SUGGESTION]\n--\u003e","chatSectionId":"1","ideContext":{"currentFile":{"path":"/home/mdbaddi/.github/workflows/opa-ci.yml","language":"","selection":{"start":0,"end":0},"includedReason":"CURRENTLY_OPEN"},"remoteContexts":null,"remoteRepositories":null,"otherFiles":[{"path":"/home/mdbaddi/.codeoss/data/User/globalStorage/googlecloudtools.datacloud/skill_bases/google-cloud-storage-basics/references/mcp-usage.md","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE"},{"path":"/home/mdbaddi/.gemini/skills/google-cloud-storage-basics/references/mcp-usage.md","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE"},{"path":"/home/mdbaddi/.local/lib/python3.12/site-packages/datahub/ingestion/source/mongodb.py","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE"},{"path":"/home/mdbaddi/.local/lib/python3.12/site-packages/datahub/cli/docker_cli.py","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE"},{"path":"/home/mdbaddi/.local/lib/python3.12/site-packages/datahub/upgrade/upgrade.py","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE"},{"path":"/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/__init__.py","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE"},{"path":"/home/mdbaddi/.gemini/extensions/vertex/README.md","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE"},{"path":"/home/mdbaddi/.local/lib/python3.12/site-packages/sentry_sdk/integrations/logging.py","language":"","selection":{"start":0,"end":0},"includedReason":"RELATED_FILE"},{"path":"/home/mdbaddi/.local/lib/python3.12/site-packages/datahub/configuration/env_vars.py","