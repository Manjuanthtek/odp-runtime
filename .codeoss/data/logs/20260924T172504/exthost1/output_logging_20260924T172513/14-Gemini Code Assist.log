n    if: github.event_name == 'push' \u0026\u0026 (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master')\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n\n      - name: Setup OPA CLI\n        uses: open-policy-agent/setup-opa@v2\n        with:\n          version: latest\n\n      - name: Build Policy Bundle\n        run: |\n          # Compiles Rego policies into a production-optimized bundle\n          opa build . -o bundle.tar.gz\n\n      - name: Build Docker Image for OPA Pod\n        run: |\n          # Placeholder for building your OPA container image.\n          # Replace 'my-opa-pod' with your actual image name and registry URL.\n          echo \"Building Docker image...\"\n          # docker build -t my-opa-pod:${{ github.sha }} .\n          # docker push my-opa-pod:${{ github.sha }}","promptCitations":[{"startIndex":136,"endIndex":359,"filepath":"/home/mdbaddi/.github/workflows/opa-ci.yml"}],"telemetry":{"CommentLines":null},"codeBlockIndex":0,"language":"yaml","checkpointFile":"f6842671f1048bc4911d04e5395b2e7869d7a636ad5032559edf5f823ca0efa0","accepted":true}]},"fileUsage":{"includedFiles":["/home/mdbaddi/.github/workflows/opa-ci.yml","/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/__init__.py","/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/build_meta.py","/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/_distutils/dist.py","/home/mdbaddi/.local/lib/python3.12/site-packages/setuptools/tests/test_sdist.py","/home/mdbaddi/.local/lib/python3.12/site-packages/pip/_internal/locations/_distutils.py","/home/mdbaddi/.gemini/skills/google-cloud-storage-basics/references/mcp-usage.md","/home/mdbaddi/.codeoss/data/User/globalStorage/googlecloudtools.datacloud/skill_bases/google-cloud-storage-basics/references/mcp-usage.md","/home/mdbaddi/.gemini/extensions/vertex/README.md","/home/mdbaddi/.local/lib/python3.12/site-packages/datahub/cli/docker_cli.py","/hom